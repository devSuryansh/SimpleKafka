#!/usr/bin/env bash
# Run the packaged SimpleKafka command. Build it first with:
#   mvn -B -DskipTests package
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shopt -s nullglob
jars=("$root"/target/simplekafka-*.jar)
shopt -u nullglob

if [[ ${#jars[@]} -eq 0 ]]; then
    echo "No jar in target/. Run: mvn -B -DskipTests package" >&2
    exit 1
fi

exec java -jar "${jars[0]}" "$@"
